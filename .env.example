# ---------------------------------------------------------------------------
# infroute-lite-bun  —  low-resource Bun AI gateway
# Copy this file to .env and fill in your keys before starting.
# ---------------------------------------------------------------------------

# Server
PORT=3000
HOST=0.0.0.0
# Optional API key required on every request (Authorization: Bearer <key> or X-Infroute-Key)
# Leave empty to disable auth (not recommended on public networks).
API_KEY=

# Upstream request timeout in milliseconds
REQUEST_TIMEOUT_MS=30000
# Max request body size in MB
MAX_BODY_MB=8

# Providers (OpenAI-compatible). JSON array. Lower "priority" is tried first.
# On a 429/502/503/504 or timeout, the gateway falls back to the next provider
# that supports the requested model.
# Example (set real keys in your .env):
# PROVIDERS='[
#   {"name":"openrouter","apiKeyEnv":"OPENROUTER_API_KEY","baseUrl":"https://openrouter.ai/api/v1","models":["*"],"priority":1},
#   {"name":"groq","apiKeyEnv":"GROQ_API_KEY","baseUrl":"https://api.groq.com/openai/v1","models":["*"],"priority":2},
#   {"name":"openai","apiKeyEnv":"OPENAI_API_KEY","baseUrl":"https://api.openai.com/v1","models":["gpt-4o-mini","gpt-4o"],"priority":3}
# ]'
PROVIDERS='[]'

# Provider API keys (referenced by apiKeyEnv above). Set the ones you use.
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: default model used when the client omits "model"
DEFAULT_MODEL=

# CORS (comma-separated origins, "*" for all)
CORS_ORIGIN=*
